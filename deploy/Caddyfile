# Caddyfile — reverse proxy production-ready.
#
# Caddy 2 (Alpine) automatizza Let's Encrypt: basta mettere il TUO dominio
# come hostname e si occupa di TLS senza altre configurazioni.
#
# Layout:
#   https://<dominio>/           -> Nitro client (statico, /srv/client)
#   https://<dominio>/api/*      -> /srv/api (PHP via FastCGI - vedi sotto)
#   https://<dominio>/cms/*      -> /srv/cms (CMS PHP - vedi sotto)
#   https://<dominio>:9090/      -> NON esposto (HealthEndpoint resta interno)
#
# Per uso locale/dev (no TLS): sostituisci "your-domain.tld" con ":80"
# e Caddy serve in chiaro.

# === Production: cambia "your-domain.tld" col tuo dominio ===
your-domain.tld {
    # Security headers globali. Stesso set del .htaccess API ma sempre
    # applicati (anche se PHP non risponde).
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(self), camera=()"
        -Server
        -X-Powered-By
    }

    # Logging strutturato (JSON) -> facile parsare con Loki/Grafana.
    log {
        output stdout
        format json
        level INFO
    }

    # Limiti contro abuse.
    request_body {
        max_size 10MB
    }

    # ===== Nitro client (statico) =====
    handle /assets/* {
        root * /srv/client
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }
    handle /bundled/* /gamedata/* /c_images/* /dcr/* /sounds/* /images/* {
        root * /srv/client
        file_server
        header Cache-Control "public, max-age=86400"
    }
    handle /renderer-config.json /ui-config.json {
        root * /srv/client
        file_server
        header Cache-Control "public, max-age=300"
    }

    # ===== API (PHP) =====
    # Per servire PHP in container serve php-fpm separato. Per ora la riga
    # sotto e' commentata; sblocca quando aggiungi un container "php-fpm".
    # handle_path /api/* {
    #     root * /srv/api
    #     php_fastcgi php-fpm:9000
    #     file_server
    # }

    # ===== CMS (PHP) =====
    # handle_path /cms/* {
    #     root * /srv/cms
    #     php_fastcgi php-fpm:9000
    #     file_server
    # }

    # ===== Default: index.html del client =====
    handle {
        root * /srv/client
        try_files {path} /index.html
        file_server
        header Cache-Control "no-cache"
    }

    # ===== Errore 404 catch-all =====
    handle_errors {
        respond "{err.status_code} {err.status_text}"
    }
}
