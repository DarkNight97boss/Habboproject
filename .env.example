# .env.example — copia in .env e popola con valori reali.
# Il file .env e' gitignored (mai committare credenziali).

# ----- Database (MariaDB container) -----
DB_ROOT_PASSWORD=change-me-very-long-random
DB_NAME=ms
DB_USER=habbo
DB_PASSWORD=change-me-also-long-random

# ----- EMU JVM tuning (override sopra Dockerfile defaults) -----
# Lascia commentato per usare i default del Dockerfile.
# EMU_JAVA_OPTS=-Xms4g -Xmx4g -XX:+UseG1GC -XX:MaxGCPauseMillis=100

# ----- Porte esposte sull'host -----
EMU_GAME_PORT=3000

# ----- AuditLog HMAC key (32+ byte casuali) -----
# Letta da Emulator via env var SEC_AUDIT_HMAC_KEY (override di config.ini).
# Genera con: openssl rand -hex 32
SEC_AUDIT_HMAC_KEY=change-me-256-bit-hex

# ----- Grafana (solo se profilo "obs" attivo) -----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-long-random

# ----- Redis (solo se profilo "redis" attivo) -----
# Auth obbligatoria anche se il container e' su rete privata habbo_net,
# perche' default Redis senza auth = stack remote-config aware.
REDIS_PASSWORD=change-me-long-random
