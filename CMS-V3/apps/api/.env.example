# ==================================================================
# CMS-V3 API — variabili d'ambiente
# Copia in .env e genera i secret con:  openssl rand -hex 64
# ==================================================================

# Porta API (8092 di default — :8091 è occupata dal Nitro-V3 standalone PHP -S server)
PORT=8092
NODE_ENV=development

# CORS origini permesse (web dev + prod). Niente wildcard!
ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Database MariaDB — stesso del vecchio CMS + EMU
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=arcturus
DB_PASSWORD=arcturus
DB_NAME=ms
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_MS=10000

# Secret per firma JWT access token (HS256). DEVE essere ≥64 byte random.
# openssl rand -hex 64
JWT_SECRET=REPLACE_ME_WITH_RANDOM_64_BYTES_HEX
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=cms-v3
JWT_AUDIENCE=cms-v3-web

# Secret separato per refresh token (HS256), DEVE essere diverso da JWT_SECRET.
REFRESH_TOKEN_SECRET=REPLACE_ME_WITH_DIFFERENT_RANDOM_64_BYTES_HEX
REFRESH_TOKEN_TTL_DAYS=14

# Argon2id parameters (production-grade)
# memoryCost in KB, timeCost iteration count, parallelism cores
ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Rate limiting (sliding window per IP)
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_GENERIC_PER_MIN=100

# CSRF
CSRF_COOKIE_NAME=cms_v3_csrf
CSRF_HEADER_NAME=x-csrf-token

# Cookie
COOKIE_SECURE=false         # true in produzione (HTTPS only)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Pino logging
LOG_LEVEL=info
LOG_PRETTY=true

# HIBP password breach check (k-anonymity, niente auth required)
HIBP_CHECK_ENABLED=true
HIBP_API_URL=https://api.pwnedpasswords.com/range
