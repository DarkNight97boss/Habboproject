#Asteria Core 3.5.5 — fork ribrandizzato di Arcturus Morningstar (GPL-3.0)

#Database Configuration.
#SECURITY: Do NOT use the MySQL 'root' account. Create a dedicated user whose privileges are
#limited to this database, and set a strong, unique password before going to production.
db.hostname=localhost
db.port=3306
db.database=ms
db.username=CHANGE_ME
db.password=CHANGE_ME
db.params=
db.pool.minsize=25
db.pool.maxsize=100

#Game Configuration.
#Host IP. Most likely just 0.0.0.0 Use 127.0.0.1 if you want to play on LAN.
game.host=0.0.0.0
game.port=3000

#Networking / anti-flood (tutti opzionali; i default sono prudenti).
#Dimensione massima di un pacchetto in ingresso. Default 417792 (limite foto camera).
#Se NON usi la camera in-client puoi abbassarlo (es. 16384) per ridurre la superficie di abuso.
networking.packet.max.length=417792
#Rate limit per connessione: finestra (s), max pacchetti con lo stesso ID, max pacchetti TOTALI.
networking.ratelimit.reset.seconds=1
networking.ratelimit.max.per.id=10
networking.ratelimit.max.total=200
#Dopo quante finestre consecutive oltre il limite totale si disconnette il client (0 = mai).
networking.ratelimit.max.violations=10
#Anti-flood pre-login: max pacchetti e secondi concessi prima di autenticarsi (0 = disattivato).
networking.auth.max.packets=50
networking.auth.timeout.seconds=30
#Max connessioni per IP (0 = illimitato). LASCIA 0 se sei dietro proxy/Cloudflare
#(l'IP del socket sarebbe quello del proxy): in quel caso limita per-IP sul proxy.
networking.max.connections.per.ip=0
#PROXY protocol: abilita SOLO se sei dietro un proxy TCP che antepone l'header PROXY
#(es. Cloudflare Spectrum con "Proxy Protocol" attivo). Con true l'EMU ricava l'IP reale
#dall'header e RIFIUTA le connessioni senza header (accetta cioe' solo traffico via proxy).
#Richiede un firewall che consenta il game port SOLO dagli IP del proxy.
networking.tcp.proxy=false

#RCON Configuration.
#RCON Host IP. Leave this at 127.0.0.1 if you're running your website on the same server as the emulator.
#SECURITY: keep rcon.host on 127.0.0.1, never expose rcon.port publicly, restrict it with a firewall.
#rcon.token adds a shared-secret check on top of the IP allow-list (empty = disabled). Set the SAME
#value here and in the CMS/API RCON config to require it.
#PRODUCTION: ALWAYS set rcon.token. Generate with:
#   openssl rand -hex 32       (Linux/macOS)
#   tools/gen_rcon_token.ps1    (Windows; in repo root)
#A 64-hex token is unguessable; without it any local process can talk RCON
#(in containerized envs the "127.0.0.1 only" guarantee evaporates).
rcon.host=127.0.0.1
rcon.port=3001
rcon.allowed=127.0.0.1;127.0.0.2
rcon.token=

#Encryption (RSA used in the client<->server Diffie-Hellman handshake).
#SECURITY: with enc.enabled=false the handshake is unencrypted. The keypair below is the DEFAULT
#Arcturus keypair shipped with every install and is therefore PUBLIC - it provides no real secrecy.
#For production, generate your own RSA keypair and update the matching public key in your client.
enc.enabled=false
enc.e=3
enc.n=86851dd364d5c5cece3c883171cc6ddc5760779b992482bd1e20dd296888df91b33b936a7b93f06d29e8870f703a216257dec7c81de0058fea4cc5116f75e6efc4e9113513e45357dc3fd43d4efab5963ef178b78bd61e81a14c603b24c8bcce0a12230b320045498edc29282ff0603bc7b7dae8fc1b05b52b2f301a9dc783b7
enc.d=59ae13e243392e89ded305764bdd9e92e4eafa67bb6dac7e1415e8c645b0950bccd26246fd0d4af37145af5fa026c0ec3a94853013eaae5ff1888360f4f9449ee023762ec195dff3f30ca0b08b8c947e3859877b5d7dced5c8715c58b53740b84e11fbc71349a27c31745fcefeeea57cff291099205e230e0c7c27e8e1c0512b